<resources>
    <!-- 主题：基于 Material3 DayNight 主题 -->
    <style name="Theme.DeviceControlAgent" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- BridgeUnlockActivity 主题：透明背景，无标题栏 -->
    <style name="Theme.BridgeUnlock" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
