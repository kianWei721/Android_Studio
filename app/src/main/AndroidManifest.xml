<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 唤醒屏幕所需权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台服务权限（API 28+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 11+（API 30+）包可见性声明 -->
    <queries>
        <!-- 微信 -->
        <package android:name="com.tencent.mm" />
        <!-- 系统设置 -->
        <package android:name="com.android.settings" />
        <!-- 允许查询所有具有 Launcher Activity 的应用，供 AppLaunchManager 通用启动 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceControlAgent">

        <!-- 主控制界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桥接解锁 Activity：在锁屏上方显示，用于请求 dismiss keyguard -->
        <activity
            android:name=".BridgeUnlockActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BridgeUnlock" />

        <!-- 无障碍服务骨架 -->
        <service
            android:name=".MinimalAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 控制用无障碍服务 -->
        <service
            android:name=".ControlAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_accessibility_service_config" />
        </service>

    </application>

</manifest>
